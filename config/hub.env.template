# ===== Hub Service Runtime Template =====
#
# This file is for packaged or managed Hub service startup.
# Use it together with scripts/starter.sh:
#
#   cp config/hub.env.template config/hub.env
#   edit config/hub.env
#   bash scripts/starter.sh start

# Bind address for web UI + APIs.
HUB_BIND_ADDR=127.0.0.1:3900

# Production should keep mutable state outside the source checkout.
# HUB_REPO_ROOT=/opt/orchestrator
# HUB_RUNTIME_DIR=/var/lib/orchestrator/control-plane
# HUB_INSTANCES_ROOT=/var/lib/orchestrator/instances

# Optional control-plane database. Leave empty for local JSON mode. Production
# should set a PostgreSQL URL and run `alembic upgrade head` before startup.
# HUB_DATABASE_URL=postgresql+psycopg://orchestrator:change-me@127.0.0.1:5432/orchestrator
HUB_NODE_ID=local
# Optional external directory for local secret references.
# HUB_SECRET_STORE_DIR=/var/lib/orchestrator/secrets

# Optional Warehouse archive worker. It stays disabled until both values are set.
# YEYING_WAREHOUSE_URL=http://127.0.0.1:6065
# YEYING_WAREHOUSE_TOOL_TOKEN=<short-lived-scoped-token>
# YEYING_WAREHOUSE_ARCHIVE_PREFIX=/services/orchestrator/events
# YEYING_WAREHOUSE_REQUEST_TIMEOUT_SECONDS=10

# Public base URL used in wallet challenge text.
# Leave empty for local/private deployment without a fixed external URL.
HUB_PUBLIC_BASE_URL=

# Router upstream.
ROUTER_BASE_URL=https://test-router.yeying.pub/v1
ROUTER_API_KEY=

# Default model and allowlist exposed by Hub.
# The default model can also be changed from the UI/API.
HUB_DEFAULT_MODEL=gpt-5.3-codex
HUB_MODEL_ALLOWLIST=gpt-5.3-codex,gpt-5.1-mini

# Wallet auth settings.
HUB_CHALLENGE_TTL_SECONDS=300
HUB_SESSION_TTL_SECONDS=86400

# Replace this in any shared or real deployment.
HUB_SESSION_SECRET=change-me-control-plane-session-secret

# Cookie secure mode:
# - auto: infer from request/proxy headers
# - always: always set Secure
# - never: never set Secure
HUB_SESSION_COOKIE_SECURE_MODE=auto

# Port range allocated to managed OpenClaw instances.
HUB_INSTANCE_PORT_START=18800
HUB_INSTANCE_PORT_END=18999

# Reserved tokens for admin/internal routes.
# Project uses HUB_INTERNAL_TOKEN through its AGENT_INTERNAL_TOKEN setting.
HUB_ADMIN_TOKEN=change-me-admin-token
HUB_INTERNAL_TOKEN=change-me-internal-token
# Set a separate secret only for trusted runtime worker processes.
HUB_WORKER_TOKEN=
# Runtime lifecycle executor is disabled by default. Enable only on a node
# with Docker Compose and a trusted Node runtime credential.
HUB_RUNTIME_EXECUTOR_ENABLED=false
HUB_WORKER_API_URL=http://127.0.0.1:3900
HUB_WORKER_ID=
HUB_WORKER_LEASE_SECONDS=300
HUB_WORKER_MAX_ATTEMPTS=5
# NODE_REGISTRY_URL=https://node.example.com
# NODE_RUNTIME_INSTANCE_ID=runtime-instance-id
# NODE_RUNTIME_AGENT_ID=orchestrator
# NODE_RUNTIME_TOKEN=<node-runtime-token>
# NODE_TRUSTED_PUBLISHER_KEYS={"publisher-key-id":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"}
# HUB_APPLICATIONS_DIR=/var/lib/orchestrator/applications
# HUB_APPLICATION_CONFIG_DIR=/var/lib/orchestrator/app-config
# HUB_APPLICATION_PUBLIC_BASE_URL=https://apps.example.com

# Optional command prefix for launching openclaw.
# Useful when outbound traffic must go through a local proxy wrapper.
# Example: HUB_OPENCLAW_PREFIX=proxychains4 -q
HUB_OPENCLAW_PREFIX=""
